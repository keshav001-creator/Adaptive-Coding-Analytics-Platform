{
    "manifest_version": 3,
    "name": "DSA Tracker",
    "version": "1.0",
    "permissions": [
        "activeTab",
         "tabs",
        "storage"
    ],
    "host_permissions": [
        "http://localhost:5000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
     "content_scripts": [
        {   
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}